{
  "name": "orbit",
  "description": "Browser-based radial logo studio with animated arms, custom colors, high-resolution exports, and controls-free embedding.",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run src/logo.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "check": "npm run test && npm run test:e2e && npm run lint && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "react": "^19.1.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
